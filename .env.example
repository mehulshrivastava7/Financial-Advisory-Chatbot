# Copy to .env and populate with your own credentials. Never commit .env.
# Optional, opt-in read-only research agent:
ADVISOR_API_KEY=replace-with-your-model-provider-api-key
ADVISOR_MODEL=replace-with-your-chat-completions-model-name
ADVISOR_API_URL=https://api.openai.com/v1/chat/completions

# Existing project integrations (modules read these variables where supported):
HUGGINGFACE_TOKEN=replace-with-your-hugging-face-token
NEWSAPI_KEY=replace-with-your-newsapi-key
REDDIT_CLIENT_ID=replace-with-your-reddit-client-id
REDDIT_CLIENT_SECRET=replace-with-your-reddit-client-secret
REDDIT_USER_AGENT=FinancialAdvisoryBot/0.1 by your-reddit-username
YOUTUBE_API_KEY=replace-with-your-youtube-data-api-key
OPENAI_API_KEY=replace-with-your-openai-api-key
